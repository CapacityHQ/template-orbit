      "drizzle-kit": "0.31.10",
      "drizzle-orm": "0.45.2",
      "html-to-pdfmake": "2.5.33",
      "idb-keyval": "6.3.0",
      "ioredis": "6.0.0",
      "lefthook": "2.1.10",
      "linkedom": "0.18.13",
      "lowlight": "3.3.0",
      "lucide-react": "1.28.0",
      "mermaid": "11.16.1",
      "motion": "13.1.1",
      "next": "16.3.4",
      "next-themes": "0.4.6",
      "pdfmake": "0.3.11",
      "pg": "8.22.0",
      "postgres": "3.4.9",
      "prettier": "3.9.6",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "resend": "6.18.1",
      "tailwind-merge": "3.6.0",
      "tailwindcss": "4.3.3",
      "typescript": "5.9.3",
      "uuid": "14.0.1",
      "vitepress": "1.6.4",
      "web-vitals": "6.1.0"
    }
  }
}
