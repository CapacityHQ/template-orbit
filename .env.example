# Host ports for the docker compose stack. Override when 5434, 6380, 9010 or
# 9011 is already taken on this machine, and update the URLs below to match.
# POSTGRES_PORT=5434
# REDIS_PORT=6380
# MINIO_PORT=9010
# MINIO_CONSOLE_PORT=9011

DATABASE_URL=postgres://orbit:orbit@localhost:5434/orbit
# DIRECT_URL=postgres://orbit:orbit@localhost:5434/orbit
DATABASE_PREPARED_STATEMENTS=false
REDIS_URL=redis://localhost:6380

BETTER_AUTH_SECRET=dev-secret-change-me-in-production-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000
# required: false
ORBIT_AUTH_ALLOWED_HOSTS=
# required: false
OAUTH_PROXY_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional override for the MCP endpoint; defaults to the app's /mcp route.
# NEXT_PUBLIC_MCP_URL=

NEXT_PUBLIC_REALTIME_URL=ws://localhost:3100
REALTIME_PORT=3100
ORBIT_TURBOPACK_DISK_CACHE=true

# required: false
GOOGLE_CLIENT_ID=
# required: false
GOOGLE_CLIENT_SECRET=
# required: false
GITHUB_CLIENT_ID=
# required: false
GITHUB_CLIENT_SECRET=

# required: false
ALLOWED_EMAIL_DOMAINS=
ORBIT_PASSWORD_AUTH=true
ORBIT_INVITE_ONLY=true

# Filled by the project creation funnel. Invitations are emailed through Resend.
RESEND_API_KEY=
EMAIL_FROM=
# The one account the database starts with, locally and on your live site.
ORBIT_ADMIN_EMAIL=
ORBIT_ADMIN_PASSWORD=

S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=orbit-uploads
S3_ACCESS_KEY_ID=orbitminio
S3_SECRET_ACCESS_KEY=orbitminio
# required: false
S3_FORCE_PATH_STYLE=

GITHUB_WEBHOOK_SECRET=dev-webhook-secret
CRON_SECRET=dev-cron-secret-change-me-in-production
# required: false
GITHUB_APP_ID=
# required: false
GITHUB_APP_PRIVATE_KEY=
# required: false
GITHUB_APP_SLUG=
# required: false
GITHUB_APP_CLIENT_ID=
# required: false
GITHUB_APP_CLIENT_SECRET=


# Slack OAuth and request verification values.
# Keep SLACK_ENABLED=false until migrations, credential rotation, Slack app
# configuration, public distribution, and a dark deployment are complete.
# required: false
SLACK_CLIENT_ID=
# required: false
SLACK_APP_ID=
# required: false
SLACK_CLIENT_SECRET=
# required: false
SLACK_SIGNING_SECRET=
SLACK_ENABLED=false
NOTIFICATION_CONVERSATIONS_ENABLED=false
NOTIFICATION_PROVIDERS_PAUSED=false

ORBIT_DEV_LOGIN=0

# Package database tooling (leave empty for the normal web stack).
# DATABASE_POOL_MAX=
# ORBIT_ALLOW_REMOTE_TEST_SETUP=
# Exact non-default db:seed target value printed by the safety guard.
# required: false
ORBIT_SEED_CONFIRM_TARGET=

# Test isolation overrides.
# ORBIT_TEST_LANE=
# TEST_DATABASE_URL=
